{
  "rewrites": [
    { "source": "/((?!sekolah/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sekolah/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
