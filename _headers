# Pengaturan header untuk Cloudflare Pages
# Halaman, service worker, dan daftar sekolah selalu diambil versi terbaru

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/sekolah/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
